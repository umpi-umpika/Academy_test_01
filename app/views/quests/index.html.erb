<% content_for :title, "Quests" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="text-4xl text-center text-[#D35400] tracking-widest mt-5 mb-1">Umpika Mettatam</h1>
  <h1 class="text-sm text-center text-[#D35400] opacity-50 tracking-widest mt-1 mb-5">アンピカ　メッタタム</h1>
  
  <div class="flex justify-center items-center mb-10">
    <div class="text-center hover:shadow-lg cursor-pointer">
      <%= link_to "Brags", brags_path, class: "px-6 py-2 rounded-md font-bold tracking-wide text-lg bg-[#D35400] hover:bg-[#E67E22] text-white block font-medium" %>
    </div>
  </div>

<div class="bg-[#F6DAC7] max-w justify-center content-center items-center p-4 rounded-md space-y-3 ml-20 mt-5 mr-20">
  <center><img src="<%= asset_path('8F894D8E-973C-4CF5-94D1-F536C768F96A_1_105_c.jpeg') %>" alt="image" class="max-h-80 items-center"></center>
  <p class= "text-xs text-center text-[#D35400]">
    "Hi! I’m an architect who has worked as a interior designer, urban engineer, and researcher.
    I’m currently on my way to becoming a software developer — but honestly, I just want to explore everything that excites me"
  </p>
</div>

<div>
  <h1 class="flex text-2xl text-life text-[#D35400] font-bold tracking-widest ml-20 mt-8 mb-4">QUESTS:</h1>
  <div class="flex justify-end text-right mt-4 mr-20">
    <%= link_to "Add Task", new_quest_path, class: "px-3.5 py-2.5 rounded-md font-bold tracking-wide bg-[#D35400] hover:bg-[#E67E22] text-white block font-medium" %>
  </div>
</div>

<div>
 <ul class="text-lg space-y-3 ml-20 mt-5 mb-5 mr-28">
        <li class="flex justify-between items-center">
          <div><input type="checkbox" checked class="mr-4">Monkey type 55 wpm, acc 95%</div>
          <div class="flex space-x-2">
            <button>🗑️</button>
          </div>
        </li>
        <li class="flex justify-between items-center">
          <div><input type="checkbox" class="mr-4">Scrum test 100%</div>
          <div class="flex space-x-2">
            <button>🗑️</button>
          </div>
        </li>
        <li class="flex justify-between items-center">
          <div><input type="checkbox" class="mr-4">Git test 25/25</div>
          <div class="flex space-x-2">
            <button>🗑️</button>
          </div>
        </li>
        <li class="flex justify-between items-center">
          <div><input type="checkbox" class="mr-4">UI design for academy test</div>
          <div class="flex space-x-2">
            <button>🗑️</button>
          </div>
        </li>
        <li class="flex justify-between items-center">
          <div><input type="checkbox" class="mr-4">Read User story mapping</div>
          <div class="flex space-x-2">
            <button>🗑️</button>
          </div>
        </li>
        <li class="flex justify-between items-center">
          <div><input type="checkbox" class="mr-4">Apply to JLPT N2-Dec 2025</div>
          <div class="flex space-x-2">
            <button>🗑️</button>
          </div>
        </li>
        <li class="flex justify-between items-center">
          <div><input type="checkbox" class="mr-4">Extra test, Business/QA/UX</div>
          <div class="flex space-x-2">
            <button>🗑️</button>
          </div>
        </li>
        <li class="flex justify-between items-center">
          <div><input type="checkbox" class="mr-4">UI design for academy test</div>
          <div class="flex space-x-2">
            <button>🗑️</button>
          </div>
        </li>
  </ul>
</div>



  <div id="quests" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @quests.any? %>
      <% @quests.each do |quest| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render quest %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", quest, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= button_to "Delete", quest, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No quests found.</p>
    <% end %>
  </div>
  <div class="text-center text-gray-400 py-4">
    <img src="<%= asset_path('farmHouse_02.png') %>" alt="image" class="max-h-96">
  </div>
</div>







