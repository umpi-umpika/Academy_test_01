<li class="flex items-center">
  <div class="flex justify-between items-center">
    <input type="checkbox" class="form-checkbox h-5 w-5 ml-4 rounded-lg text-blue-500 border-gray-300 focus:ring-blue-500 transition duration-150 ease-in-" <%= quest.status? ? "checked" : "" %>>
    <%= link_to quest, class: "w-full px-4 py-2 cursor-pointer hover:font-bold text-lg transition-all duration-50 ease-in-out" do %>
      <%= quest.name %>
    <% end %>
  </div>
</li>
